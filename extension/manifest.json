{
  "manifest_version": 3,
  "name": "Conversation Graph for Claude",
  "version": "0.1.0",
  "description": "Visualize claude.ai conversations as a tree of branches. Hover to preview, click to jump.",
  "permissions": ["storage"],
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content/mainWorld.ts"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Conversation Graph for Claude"
  }
}
